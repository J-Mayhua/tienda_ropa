{
  "functions": {
    "api/*.php": { "runtime": "vercel-php@0.9.0" },
    "publico/*.php": { "runtime": "vercel-php@0.9.0" }
  },
  "routes": [
    { "src": "/api/health", "dest": "/api/health.php" },
    { "src": "/", "dest": "/publico/index.php" },
    { "src": "/publico/(.*)", "dest": "/publico/$1" },
    { "src": "/(.*)", "dest": "/publico/index.php" }
  ]
}
